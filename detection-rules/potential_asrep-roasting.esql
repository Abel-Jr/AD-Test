FROM winlogbeat-*
| WHERE event.code == "4768" 
    AND (winlog.event_data.PreAuthType == "0" OR winlog.event_data.PreAuthType IS NULL)
    AND NOT ENDS_WITH(winlog.event_data.TargetUserName, "$")
| STATS
    distinct_targets = COUNT_DISTINCT(winlog.event_data.TargetUserName),
    total_requests = COUNT(*)
    BY source.ip, bucket = BUCKET(@timestamp, 10 minute)
| WHERE distinct_targets >= 7
| SORT distinct_targets DESC