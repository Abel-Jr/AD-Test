FROM winlogbeat-*
| WHERE event.code == "4769" 
    AND winlog.event_data.TicketEncryptionType == "0x17"
    AND NOT ENDS_WITH(winlog.event_data.ServiceName, "$")
    AND winlog.event_data.Status == "0x0"
| STATS
    distinct_spns = COUNT_DISTINCT(winlog.event_data.ServiceName),
    total_requests = COUNT(*),
    services = VALUES(winlog.event_data.ServiceName)
    BY winlog.event_data.TargetUserName, bucket = BUCKET(@timestamp, 10 minute)
| WHERE distinct_spns >= 7
| SORT distinct_spns DESC